# Telegram Bot Token from @BotFather
BOT_TOKEN=

# Google Gemini API Key
GEMINI_API_KEY=

# Dashboard va barcha /api/* marshrutlari uchun maxfiy administrator paroli
ADMIN_PASSWORD=

# Polling holati: Render uchun sukut bo'yicha true, AI Studio uchun false (409 xatosini oldini olish uchun)
# ENABLE_POLLING=false

# Render serveringizning tashqi manzili (faqat o'zini ping qilish uchun)
RENDER_EXTERNAL_URL=https://telegram-bot-imap.onrender.com

# HTTP Server Port
PORT=3000
